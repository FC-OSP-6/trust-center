# TL;DR  -->  EXAMPLE environment file

#   - placeholder values here only  -->  allows for replication locally
#   - copy to your real .env  -->  add in your actual keys / secrets
#   - variables prefixed with VITE_ are exposed to the browser bundle (client)


#  ----------  client-only (vite)  ----------

# base url for the api
HOST=http://localhost

# vite dev server port for direct client-only runs
VITE_DEV_PORT=5173

# supabase configuration (safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your_anon_key_goes_here


#  ----------  server-only  ----------

# server runs here
SERVER_PORT=4000
# NODE_ENV=development


# Database variables (Postgres)

# server uses this to connect to postgres (local or hosted)
# you will need to URL-encode special characters in the password  -->  "p@ssw0rd!" -> "p%40ssw0rd%21"
DATABASE_URL=postgres://username:password@localhost:5432/trust-center

# docker compose defaults to its local postgres service.
# set this only when you intentionally want the dockerized api to talk to a remote database instead.
# warning: avoid running seed / cleanapply against a remote database unless you mean to change that environment.
# DOCKER_REMOTE_DATABASE_URL=postgres://username:password@db.example.com:5432/trust-center

# postgres pool tuning
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000


# backend optimization / observability flags

# enables request-linked perf logs for graphql/db/cache/memo
DEBUG_PERF=false

# shared read-cache adapter  -->  "lru" is the current local/prototype default  ;  "redis" is a stub path for future production wiring
CACHE_ADAPTER=lru
REDIS_URL=redis://localhost:6379
CACHE_NAMESPACE=trust-center

# max number of entries stored in the shared in-memory lru cache  -->  higher = better hit rate, but more memory usage
CACHE_MAX_ITEMS=500

# demo resilience flag
# true  -->  services may fall back to seed json for known db/env failures
# false -->  surface db failures directly (better for perf/debugging and mvp hardening)
ALLOW_SEED_FALLBACK=false


# stretch  -->  AI + LLM

# --- frozen AI env contract (EPIC 007-C) ---
# mode: "online" (default) or "offline"
# AI_MODE=online

# provider: "hosted-chat" (default for online) or "ollama" (default for offline)
# AI_PROVIDER=hosted-chat

# hosted-chat provider (OpenAI-compatible endpoint)
# AI_API_KEY=Replace_Me
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ollama provider (local offline model)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- legacy vars (kept for reference — not used by EPIC 007-C providers) ---
# llm selection  -->  choose provider: "openai", "openrouter", other if configured
# LLM_PROVIDER=openrouter

# paid (OpenAI)
# OPENAI_API_KEY=Replace_Me
# OPENAI_MODEL=gpt-5-nano

# free (openrouter)
# OPENROUTER_API_KEY=Replace_Me
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# safe defaults to keep output bounded + predictable
# AI_MAX_TOKENS=500
# AI_TEMPERATURE=0.2
# AI_MAX_SOURCES=5
# AI_MAX_CONTEXT_CHARS=12000


# stretch  -->  embedings + RAG

# local embeddings model id  -->  transformers.js example
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# Knowledge Base (KB)  -->  example vector DB for RAG
# PINECONE_API_KEY=Replace_Me
# PINECONE_INDEX=trust-center
# PINECONE_NAMESPACE=dev


## stretch  -->  admin auth

# demo-only admin token used by graphql mutations in local/dev verification
# this is NOT production auth  -->  future jwt/rbac can replace it later
ADMIN_SECRET=replace-me

# comma-separated list of emails allowed to perform admin actions
# example  -->  ADMIN_EMAIL_ALLOWLIST=admin1@example.com,admin2@example.com
# ADMIN_EMAIL_ALLOWLIST=

# if using supabase jwt to verify
# SUPABASE_JWT_SECRET=Replace_Me
